@prefix : <http://www.example.org/bookstore#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.example.org/bookstore>
    rdf:type owl:Ontology .

# =========================================
# BASE CLASSES
# =========================================

:Book rdf:type owl:Class .

:Fiction rdf:type owl:Class ;
    rdfs:subClassOf :Book .

:NonFiction rdf:type owl:Class ;
    rdfs:subClassOf :Book .

# =========================================
# FICTION GENRES (5 types)
# =========================================

:Fantasy rdf:type owl:Class ;
    rdfs:subClassOf :Fiction .

:Mystery rdf:type owl:Class ;
    rdfs:subClassOf :Fiction .

:Romance rdf:type owl:Class ;
    rdfs:subClassOf :Fiction .

:YoungAdult rdf:type owl:Class ;
    rdfs:subClassOf :Fiction .

:Thriller rdf:type owl:Class ;
    rdfs:subClassOf :Fiction .

# =========================================
# NON-FICTION GENRES (5 types)
# =========================================

:History rdf:type owl:Class ;
    rdfs:subClassOf :NonFiction .

:Biography rdf:type owl:Class ;
    rdfs:subClassOf :NonFiction .

:Technical rdf:type owl:Class ;
    rdfs:subClassOf :NonFiction .

:Cookbook rdf:type owl:Class ;
    rdfs:subClassOf :NonFiction .

:Education rdf:type owl:Class ;
    rdfs:subClassOf :NonFiction .

# =========================================
# INFERRED CLASSES (for each genre)
# =========================================

:FantasyBook rdf:type owl:Class .
:MysteryBook rdf:type owl:Class .
:RomanceBook rdf:type owl:Class .
:YoungAdultBook rdf:type owl:Class .
:ThrillerBook rdf:type owl:Class .
:HistoryBook rdf:type owl:Class .
:BiographyBook rdf:type owl:Class .
:TechnicalBook rdf:type owl:Class .
:CookbookBook rdf:type owl:Class .
:EducationBook rdf:type owl:Class .

# =========================================
# PROPERTIES
# =========================================

:hasGenre rdf:type owl:ObjectProperty ;
    rdfs:domain :Book ;
    rdfs:range owl:Class .

:title rdf:type owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:string .

:author rdf:type owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:string .

:price rdf:type owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:decimal .

:isbn rdf:type owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:string .

:rating rdf:type owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Book rating on a scale of 0 to 5" .

# =========================================
# REASONING RULES (OWL 2 RL)
# =========================================

# Rule: Book with hasGenre :Fantasy → rdf:type :FantasyBook
:FantasyBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :Fantasy
            ]
        )
    ] .

# Rule: Book with hasGenre :Mystery → rdf:type :MysteryBook
:MysteryBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :Mystery
            ]
        )
    ] .

# Rule: Book with hasGenre :Romance → rdf:type :RomanceBook
:RomanceBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :Romance
            ]
        )
    ] .

# Rule: Book with hasGenre :YoungAdult → rdf:type :YoungAdultBook
:YoungAdultBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :YoungAdult
            ]
        )
    ] .

# Rule: Book with hasGenre :Thriller → rdf:type :ThrillerBook
:ThrillerBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :Thriller
            ]
        )
    ] .

# Rule: Book with hasGenre :History → rdf:type :HistoryBook
:HistoryBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :History
            ]
        )
    ] .

# Rule: Book with hasGenre :Biography → rdf:type :BiographyBook
:BiographyBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :Biography
            ]
        )
    ] .

# Rule: Book with hasGenre :Technical → rdf:type :TechnicalBook
:TechnicalBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :Technical
            ]
        )
    ] .

# Rule: Book with hasGenre :Cookbook → rdf:type :CookbookBook
:CookbookBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :Cookbook
            ]
        )
    ] .

# Rule: Book with hasGenre :Education → rdf:type :EducationBook
:EducationBook
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:hasValue :Education
            ]
        )
    ] .

# =========================================
# INFERRED CLASS FOR BEST RECOMMENDATIONS
# =========================================

# Rule: Book with rating >= 4.5 → rdf:type :BestRecommend
:BestRecommend rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Book
            [
                rdf:type owl:Restriction ;
                owl:onProperty :rating ;
                owl:minInclusive "4.5"^^xsd:decimal
            ]
        )
    ] ;
    rdfs:subClassOf :Book .