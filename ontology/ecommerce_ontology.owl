@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xs: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://www.example.org/ecommerce#> .

: a owl:Ontology .

:Product a owl:Class .

:Electronics a owl:Class .
:Laptop a owl:Class ;
    rdfs:subClassOf :Electronics .
:Smartphone a owl:Class ;
    rdfs:subClassOf :Electronics .
:Accessory a owl:Class ;
    rdfs:subClassOf :Electronics .
:GamingLaptop a owl:Class ;
    rdfs:subClassOf :Laptop .

:compatibleWith a owl:ObjectProperty .

:name a owl:DatatypeProperty .
:brand a owl:DatatypeProperty .
:price a owl:DatatypeProperty .
:category a owl:DatatypeProperty .
:inStock a owl:DatatypeProperty .